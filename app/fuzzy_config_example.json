  "simple_temperature_control": {
    "description": "Simple temperature control system example",
    "input_variables": {
      "temperature": {
        "min": 0,
        "max": 50,
        "step": 1,
        "membership_functions": {
          "cold": {
            "type": "trapmf",
            "params": [0, 0, 10, 20]
          },
          "warm": {
            "type": "trapmf",
            "params": [15, 25, 35, 40]
          },
          "hot": {
            "type": "trapmf",
            "params": [35, 45, 50, 50]
          }
        }
      },
      "humidity": {
        "min": 0,
        "max": 100,
        "step": 1,
        "membership_functions": {
          "low": {
            "type": "trapmf",
            "params": [0, 0, 30, 50]
          },
          "medium": {
            "type": "trapmf",
            "params": [40, 60, 80, 90]
          },
          "high": {
            "type": "trapmf",
            "params": [80, 90, 100, 100]
          }
        }
      }
    },
    "output_variable": {
      "name": "cooling_power",
      "min": 0,
      "max": 100,
      "step": 1,
      "membership_functions": {
        "low": {
          "type": "trimf",
          "params": [0, 0, 30]
        },
        "medium": {
          "type": "trimf",
          "params": [20, 50, 80]
        },
        "high": {
          "type": "trimf",
          "params": [70, 100, 100]
        }
      }
    },
    "rules": [
      {
        "antecedent": [
          {"variable": "temperature", "membership": "cold"},
          {"variable": "humidity", "membership": "low"}
        ],
        "consequent": "low"
      },
      {
        "antecedent": [
          {"variable": "temperature", "membership": "cold"},
          {"variable": "humidity", "membership": "medium"}
        ],
        "consequent": "low"
      },
      {
        "antecedent": [
          {"variable": "temperature", "membership": "cold"},
          {"variable": "humidity", "membership": "high"}
        ],
        "consequent": "medium"
      },
      {
        "antecedent": [
          {"variable": "temperature", "membership": "warm"},
          {"variable": "humidity", "membership": "low"}
        ],
        "consequent": "medium"
      },
      {
        "antecedent": [
          {"variable": "temperature", "membership": "warm"},
          {"variable": "humidity", "membership": "medium"}
        ],
        "consequent": "medium"
      },
      {
        "antecedent": [
          {"variable": "temperature", "membership": "warm"},
          {"variable": "humidity", "membership": "high"}
        ],
        "consequent": "high"
      },
      {
        "antecedent": [
          {"variable": "temperature", "membership": "hot"},
          {"variable": "humidity", "membership": "low"}
        ],
        "consequent": "high"
      },
