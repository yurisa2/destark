# Use Amazon Linux 2 as base image and install AWS Glue libraries manually
FROM amazonlinux:2

# Set environment variables
ENV PYTHONPATH=/opt/amazon/lib/python3.9/site-packages
ENV GLUE_HOME=/opt/amazon/glue
ENV AWS_DEFAULT_REGION=us-east-1

# Install system dependencies (no GDAL required)
RUN yum update -y && \
    yum install -y \
        gcc \
        gcc-c++ \
        python3-devel \
        python3-pip \
        wget \
        unzip \
        curl \
        && yum clean all

# Install Python dependencies for raster processing and fuzzy logic (tifffile version)
RUN pip3 install --no-cache-dir \
    numpy>=1.21.0 \
    scipy>=1.7.0 \
    boto3>=1.26.0 \
    click>=8.0.0 \
    attrs>=21.0.0 \
    certifi>=2021.0.0 \
    numba>=0.56.0 \
    packaging>=20.0 \
    scikit-fuzzy>=0.4.2 \
    tifffile>=2023.0.0 \
    tqdm>=4.62.0

# Verify installations
RUN python3 -c "import tifffile; print('✓ tifffile imported successfully')" && \
    python3 -c "import skfuzzy; print('✓ scikit-fuzzy imported successfully')" && \
    python3 -c "import numpy; print('✓ numpy version:', numpy.__version__)" && \
    python3 -c "import scipy; print('✓ scipy version:', scipy.__version__)" && \
    python3 -c "import boto3; print('✓ boto3 imported successfully')"

# Set working directory
WORKDIR /opt/amazon/glue

# Create a simple test script to verify the environment
RUN echo '#!/bin/bash\n\
echo "Testing tifffile environment..."\n\
python3 -c "import tifffile; import numpy as np; data = np.random.rand(10, 10); tifffile.imwrite(\"test.tif\", data); print(\"✓ tifffile write test passed\")"\n\
python3 -c "import tifffile; data = tifffile.imread(\"test.tif\"); print(f\"✓ tifffile read test passed, shape: {data.shape}\")"\n\
echo "Environment setup complete!"\n\
' > /opt/amazon/glue/test_tifffile.sh && chmod +x /opt/amazon/glue/test_tifffile.sh

# Default command
CMD ["/bin/bash"] 