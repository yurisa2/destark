# Use Amazon Linux 2 as base image and install AWS Glue libraries manually
FROM amazonlinux:2

# Set environment variables
ENV PYTHONPATH=/opt/amazon/lib/python3.9/site-packages
ENV GLUE_HOME=/opt/amazon/glue
ENV AWS_DEFAULT_REGION=us-east-1

# Install system dependencies for GDAL and geospatial libraries
RUN yum update -y && \
    yum install -y \
        gcc \
        gcc-c++ \
        gdal-devel \
        gdal-bin \
        proj-devel \
        proj-bin \
        geos-devel \
        hdf5-devel \
        netcdf-devel \
        libspatialindex-devel \
        python3-devel \
        python3-pip \
        wget \
        unzip \
        curl \
        && yum clean all

# Set GDAL environment variables
ENV GDAL_CONFIG=/usr/bin/gdal-config

# Install Python dependencies for raster processing and fuzzy logic
RUN pip3 install --no-cache-dir \
    numpy>=1.21.0 \
    scipy>=1.7.0 \
    boto3>=1.26.0 \
    click>=8.0.0 \
    cligj>=0.5.0 \
    attrs>=21.0.0 \
    certifi>=2021.0.0 \
    affine>=2.3.0 \
    pyparsing>=3.0.0 \
    numba>=0.56.0 \
    packaging>=20.0 \
    scikit-fuzzy>=0.4.2

# Install rasterio and geospatial libraries
RUN pip3 install --no-cache-dir \
    rasterio>=1.3.0 \
    fiona>=1.8.0 \
    shapely>=1.8.0

# Verify installations
RUN python3 -c "import rasterio; print('✓ rasterio version:', rasterio.__version__)" && \
    python3 -c "import skfuzzy; print('✓ scikit-fuzzy imported successfully')" && \
    python3 -c "import numpy; print('✓ numpy version:', numpy.__version__)" && \
    python3 -c "import scipy; print('✓ scipy version:', scipy.__version__)" && \
    python3 -c "import fiona; print('✓ fiona imported successfully')" && \
    python3 -c "import shapely; print('✓ shapely imported successfully')" && \
    python3 -c "import boto3; print('✓ boto3 imported successfully')"

# Set working directory
WORKDIR /opt/amazon/glue

# Create a simple test script to verify the environment
RUN echo '#!/bin/bash\n\
echo "=== AWS Glue with Rasterio Environment ==="\n\
echo "Python version: $(python3 --version)"\n\
echo "Rasterio version: $(python3 -c "import rasterio; print(rasterio.__version__)")"\n\
echo "Numpy version: $(python3 -c "import numpy; print(numpy.__version__)")"\n\
echo "Scikit-fuzzy available: $(python3 -c "import skfuzzy; print(\"Yes\")" 2>/dev/null || echo "No")"\n\
echo "Environment ready for raster fuzzy processing!"\n\
' > /opt/amazon/glue/test_environment.sh && chmod +x /opt/amazon/glue/test_environment.sh

# Keep the container running
CMD ["/bin/bash"] 